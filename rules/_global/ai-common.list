# Shared AI infrastructure and supplementary services (Loon).
# Place after service-specific and payment rules, before broad AI fallbacks.
# Route these shared dependencies through the same egress as Claude.
# Example: RULE-SET,ai-common,AI-Common

# Search.
DOMAIN-SUFFIX,algolia.net

# Telemetry and analytics.
DOMAIN-SUFFIX,sentry.io
DOMAIN-SUFFIX,segment.io
DOMAIN-SUFFIX,observeit.net
DOMAIN-SUFFIX,api.statsig.com
DOMAIN,static.cloudflareinsights.com
# Service-specific Datadog endpoints remain in their respective service sets.

# Feature flags.
DOMAIN-SUFFIX,launchdarkly.com
DOMAIN-SUFFIX,featuregates.org

# Shared authentication and certificate validation.
# Service-specific subdomains must match before these broader suffix rules.
DOMAIN-SUFFIX,auth0.com
DOMAIN-SUFFIX,identrust.com

# Muse.
DOMAIN-SUFFIX,muse.ai
DOMAIN-SUFFIX,metaaivm.com
